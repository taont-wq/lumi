# ================================================================
# Environment variables cho tra-cuu.noithatlumi.vn
# ================================================================
# File này là MẪU. Copy thành `.env` (không commit) cho local dev.
# Trên Vercel: thêm các biến này trong Project Settings > Environment Variables.
# Tiền tố VITE_ bắt buộc để Vite expose ra client code.
# ================================================================

# ----- AI (Google Gemini) -----
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ----- App URL (cho self-referential links, OAuth callback) -----
APP_URL="MY_APP_URL"

# ----- Analytics: Google Analytics 4 -----
# Format: G-XXXXXXXXXX. Lấy từ https://analytics.google.com
VITE_GA_MEASUREMENT_ID=

# ----- Analytics: Google Tag Manager -----
# Format: GTM-XXXXXXX.
VITE_GTM_ID=

# ----- Analytics: Meta Pixel (Facebook) -----
# Format: 15 chữ số.
VITE_META_PIXEL_ID=

# ================================================================
# SUPABASE (Database độc lập — thay thế localStorage)
# ================================================================
# Cách lấy:
#   1. Vào https://supabase.com > tạo project mới
#   2. Project Settings > API > copy "Project URL" và "anon public key"
#   3. Chạy file SUPABASE_SCHEMA.sql trong SQL Editor
#   4. Tạo admin user trong Authentication > Users (set role="admin" trong app_metadata)
# ================================================================

# Supabase Project URL (vd: https://xxxxx.supabase.co)
VITE_SUPABASE_URL=

# Supabase anon public key (KHÔNG phải service_role key — service_role phải giữ bí mật)
VITE_SUPABASE_ANON_KEY=
